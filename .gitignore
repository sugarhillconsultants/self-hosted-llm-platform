# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*.auto.tfvars
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Secrets / local
.env
*.pem
kubeconfig*
# Model weights never go in git
*.safetensors
*.gguf
models/
# Eval run outputs (baselines ARE committed)
evals/reports/*
!evals/reports/.gitkeep
# Local cluster credentials (generated by local/kind-up.sh)
local/.env.local
# Terraform plan/run output written by CI and scripts
infra/terraform/**/plan.txt
infra/terraform/**/run.txt
infra/terraform/**/nodes.txt
infra/terraform/**/tfplan
# EKS gateway credentials (generated by scripts/deploy-gateway.sh)
local/.env.eks
# Phase 3 run output (copy what goes into docs/evidence)
loadtest/results/
